# Optional. The dev server proxies /api/* to the backend (see vite.config.ts).
# Only needed if the backend isn't reachable at http://localhost:8000 — e.g.
# docker-compose sets this to http://backend:8000 automatically.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Android app only (frontend/src/services/api.ts's isNativeApp branch). The
# web build ignores this entirely — it always talks to /api/v1 and relies on
# Vercel's rewrite proxy (vercel.json). There is no Vercel proxy inside the
# APK, so the Android build needs an absolute API origin baked in at build
# time. Defaults to the production Railway backend if unset, so this is only
# needed to point a local Capacitor dev build at a different backend (NEVER
# localhost/10.0.2.2 in a release build — the Android device/emulator can't
# reach your machine's localhost under that name in a release context, and
# shipping a debug-only address in a real release APK is a Phase 3 violation).
# VITE_API_BASE_URL=https://backend-production-65bb9.up.railway.app
