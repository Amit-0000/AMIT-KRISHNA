# Copy to api/.env for local (non-Docker) runs, or edit in place — docker-compose.yml
# loads this file directly for the backend service's dev environment.
#
# Values here are safe ONLY for local development. Before deploying anywhere
# real, generate fresh secrets:
#   openssl rand -hex 32   (JWT_SECRET, AUDIT_IP_SALT)

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:5173
DEBUG=true
LOG_LEVEL=DEBUG
# https://localhost is the Capacitor Android app's WebView origin (androidScheme
# default) — required here (and on the real deployment's ALLOWED_ORIGINS) for
# the Android app to be allowed through CORS at all. See ANDROID_APP.md.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost
COOKIE_SECURE=false
# Comma-separated reverse-proxy IPs allowed to set X-Forwarded-For (see
# api/core/middleware.py::client_ip and security-review.md F-14). Empty here
# because this compose topology has no reverse proxy in front of the
# backend — set this to your real proxy's IP(s) in an actual deployment.
TRUSTED_PROXY_IPS=

# ── Database (docker-compose overrides host to `postgres`) ──────────────────
DATABASE_URL=postgresql+asyncpg://voiceguard:voiceguard@localhost:5432/voiceguard
# 20/90 (raised from 10/50 — see api/core/config.py's comment and
# security-review.md F-17: 10/50 still exhausted under a real 100-VU k6
# baseline load test)
DB_POOL_MIN_SIZE=20
DB_POOL_MAX_SIZE=90
DB_POOL_TIMEOUT_S=15

# ── Redis (docker-compose overrides host to `redis`) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=b6f1e6c1a6e94e3f8a6c1b9d2f4e7a1c9d3b5f8e0a2c4d6f8b1e3a5c7d9f0b2e4
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_S=900
JWT_REFRESH_TOKEN_TTL_S=2592000

# ── Email ─────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: "console" | "resend" | "smtp"
#   console — logs emails instead of sending them (this file's default; not
#             valid in production, see Settings.validate_production).
#   resend  — Resend, reached over SMTP like any other provider. Needs only
#             RESEND_API_KEY; host/port/username are Resend's fixed values
#             (see RESEND_SMTP_HOST/RESEND_SMTP_PORT in api/core/config.py).
#             Resend's shared onboarding@resend.dev sender only delivers to
#             the account owner's own address until a domain is verified.
#   smtp    — any real mailbox/SMTP provider via SMTP_HOST/PORT/USERNAME/
#             PASSWORD below. docker-compose.yml points this at the local
#             Mailpit dev-capture service (SMTP_HOST=mailpit, no auth) by
#             default — open http://localhost:8025 to read captured mail
#             instead of a real inbox. For production, point these at a
#             real provider (e.g. smtp.gmail.com:587 with an app password)
#             instead of Mailpit.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@voiceguard.app
EMAIL_FROM_NAME=VoiceGuard
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# ── Rate limiting (auth routes) ──────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_HOUR_PER_IP=10
RATE_LIMIT_REGISTER_PER_HOUR_PER_IP=5
RATE_LIMIT_RESET_PER_HOUR_PER_IP=3
RATE_LIMIT_RESEND_VERIFICATION_PER_HOUR_PER_IP=3
RATE_LIMIT_VERIFY_EMAIL_PER_HOUR_PER_IP=10
RATE_LIMIT_SCAN_CREATE_PER_HOUR_PER_USER=30
RATE_LIMIT_PREDICT_PER_HOUR_PER_USER=30

# ── Audit ────────────────────────────────────────────────────────────────────
AUDIT_IP_SALT=f3a1c9d7b5e8f0a2c4d6e8f0b2c4d6e8f0a2c4d6e8f0b2c4d6e8f0a2c4d6e8f0

# ── Scan upload & storage (Audio Upload & Scan Management slice) ────────────
MAX_UPLOAD_SIZE_BYTES=10485760
MIN_UPLOAD_SIZE_BYTES=1024
STORAGE_BACKEND=local
UPLOAD_STORAGE_ROOT=data/uploads
SCAN_EXPIRY_HOURS=24
PREPROCESSING_MAX_ATTEMPTS=3

# ── Malware scanning (api/scans/malware_scan.py) — docker-compose overrides
# host to `clamav`, its sidecar service ────────────────────────────────────
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_TIMEOUT_S=20.0
