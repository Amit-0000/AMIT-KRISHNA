# Version control
.git/
.gitignore

# Python cache and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# Training data — never bake datasets into an image
data/

# Trained checkpoints — mounted at runtime, not baked in
checkpoints/

# TensorBoard logs — only needed locally
runs/

# Dev / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Local secrets — never bake a real .env into an image layer
# (security-review.md F-29; api/.env.example is intentionally NOT excluded,
# it's a documented dev-placeholder file meant to ship)
.env
api/.env
frontend/.env

# Docs and notebooks — not needed by the server
docs/
notebooks/
README.md

# Scripts and configs — only needed for training, not inference
scripts/
configs/

# Demo app — separate concern from the FastAPI server
demo/
