# Root-level ignores. voiceguard/.gitignore and automated_test/.gitignore
# hold additional, more specific rules for their own subtrees.

# Python
__pycache__/
*.py[cod]

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Office lock files (created while a report .xlsx is open)
~$*.xlsx
~$*.xls
~$*.docx
